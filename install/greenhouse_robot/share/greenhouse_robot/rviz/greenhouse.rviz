Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description

    # ===== SENSORS =====
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 0; 255; 0

    - Class: rviz_default_plugins/Odometry
      Name: Wheel Odometry (raw)
      Enabled: true
      Topic:
        Value: /odom
      Keep: 10
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shaft Length: 0.03
      Shaft Diameter: 0.01
      Head Length: 0.015
      Head Diameter: 0.02
      Shape:
        Value: Arrow
      Covariance:
        Value: false

    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw/image_color

    - Class: rviz_default_plugins/Odometry
      Name: EKF Odometry (fused)
      Enabled: true
      Topic:
        Value: /odometry/filtered
      Keep: 20
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
      Color: 255; 0; 255
      Covariance:
        Value: true

    - Class: rviz_default_plugins/AccelStamped
      Name: IMU Acceleration
      Enabled: true
      Topic:
        Value: /imu

    # ===== SLAM MAP =====
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: true
      Topic:
        Value: /map
        Reliability Policy: Reliable
      Update Topic:
        Value: /map_updates
      Color Scheme: map
      Alpha: 0.7

    # ===== NAV2 =====
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: false
      Topic:
        Value: /global_costmap/costmap
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.5

    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: false
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.5

    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic:
        Value: /plan
      Color: 255; 0; 0
      Alpha: 1.0

    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
      Color: 0; 0; 255
      Alpha: 1.0

  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Pitch: 1.5708
      Yaw: 0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
