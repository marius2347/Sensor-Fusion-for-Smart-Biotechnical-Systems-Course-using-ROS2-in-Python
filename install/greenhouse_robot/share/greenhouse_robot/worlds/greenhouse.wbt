#VRML_SIM R2023b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/develop/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/develop/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/develop/projects/robots/robotis/turtlebot/protos/TurtleBot3Burger.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/develop/projects/devices/robotis/protos/RobotisLds01.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/develop/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/develop/projects/appearances/protos/SandyGround.proto"

WorldInfo {
  info [
    "Autonomous Greenhouse Robot - Sensor Fusion Project"
  ]
  title "Greenhouse Environment"
  basicTimeStep 20
}
Viewpoint {
  orientation -0.35 0.0 0.94 4.5
  position 8 12 10
  follow "TurtleBot3Burger"
}
TexturedBackground {
  texture "noon_park_empty"
  skybox FALSE
}
TexturedBackgroundLight {
}

# ==================== GREENHOUSE FLOOR ====================
Floor {
  translation 5 5 0
  size 12 12
  tileSize 1 1
  appearance SandyGround {
    textureTransform TextureTransform {
      scale 6 6
    }
  }
}

# ==================== GREENHOUSE WALLS ====================
Solid {
  translation 5 11 0.5
  children [ Shape { appearance PBRAppearance { baseColor 0.85 0.85 0.8 roughness 0.9 } geometry Box { size 12 0.1 1 } } ]
  name "wall_north"
  boundingObject Box { size 12 0.1 1 }
}
Solid {
  translation 5 -1 0.5
  children [ Shape { appearance PBRAppearance { baseColor 0.85 0.85 0.8 roughness 0.9 } geometry Box { size 12 0.1 1 } } ]
  name "wall_south"
  boundingObject Box { size 12 0.1 1 }
}
Solid {
  translation 11 5 0.5
  children [ Shape { appearance PBRAppearance { baseColor 0.85 0.85 0.8 roughness 0.9 } geometry Box { size 0.1 12 1 } } ]
  name "wall_east"
  boundingObject Box { size 0.1 12 1 }
}
Solid {
  translation -1 5 0.5
  children [ Shape { appearance PBRAppearance { baseColor 0.85 0.85 0.8 roughness 0.9 } geometry Box { size 0.1 12 1 } } ]
  name "wall_west"
  boundingObject Box { size 0.1 12 1 }
}

# ==================== PLANT ROW 1 (y=2) ====================
Solid { translation 2 2 0.25 children [ Shape { appearance PBRAppearance { baseColor 0.1 0.6 0.15 roughness 0.8 } geometry Cylinder { height 0.5 radius 0.15 } } ] name "plant_r1_1" boundingObject Cylinder { height 0.5 radius 0.15 } }
Solid { translation 3.5 2 0.25 children [ Shape { appearance PBRAppearance { baseColor 0.15 0.65 0.1 roughness 0.8 } geometry Cylinder { height 0.5 radius 0.15 } } ] name "plant_r1_2" boundingObject Cylinder { height 0.5 radius 0.15 } }
Solid { translation 5 2 0.25 children [ Shape { appearance PBRAppearance { baseColor 0.2 0.55 0.12 roughness 0.8 } geometry Cylinder { height 0.5 radius 0.15 } } ] name "plant_r1_3" boundingObject Cylinder { height 0.5 radius 0.15 } }
Solid { translation 6.5 2 0.25 children [ Shape { appearance PBRAppearance { baseColor 0.12 0.62 0.18 roughness 0.8 } geometry Cylinder { height 0.5 radius 0.15 } } ] name "plant_r1_4" boundingObject Cylinder { height 0.5 radius 0.15 } }
Solid { translation 8 2 0.25 children [ Shape { appearance PBRAppearance { baseColor 0.18 0.58 0.14 roughness 0.8 } geometry Cylinder { height 0.5 radius 0.15 } } ] name "plant_r1_5" boundingObject Cylinder { height 0.5 radius 0.15 } }

