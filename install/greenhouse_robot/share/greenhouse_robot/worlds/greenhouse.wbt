# ==================== SHELVES ====================
Solid { translation 9.5 3.5 0.3 children [ Shape { appearance PBRAppearance { baseColor 0.6 0.4 0.2 roughness 0.7 } geometry Box { size 0.6 2 0.6 } } ] name "shelf_1" boundingObject Box { size 0.6 2 0.6 } }
Solid { translation 0.5 6.5 0.3 children [ Shape { appearance PBRAppearance { baseColor 0.6 0.4 0.2 roughness 0.7 } geometry Box { size 0.6 2 0.6 } } ] name "shelf_2" boundingObject Box { size 0.6 2 0.6 } }

# ==================== THE ROBOT ====================
# The TurtleBot3Burger PROTO has built-in gyro and accelerometer.
# We add InertialUnit (for orientation), imu_link, GPS, Camera, and LIDAR.
TurtleBot3Burger {
  translation 1 0.5 0
  rotation 0 0 1 1.5708
  controller "<extern>"
  controllerArgs [
    ""
  ]
  extensionSlot [
    Solid {
      name "imu_link"
    }
    GPS {
    }
    Compass {
      name "compass"
    }
    InertialUnit {
      name "inertial_unit"
    }
    Camera {
      translation 0.05 0 0.04
      rotation 0 0 1 0
      name "camera"
      width 320
      height 240
    }
    RobotisLds01 {
    }
  ]
}
