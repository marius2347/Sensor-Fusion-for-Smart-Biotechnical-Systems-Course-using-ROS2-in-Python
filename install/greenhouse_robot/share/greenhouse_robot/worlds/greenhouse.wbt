Solid { translation 6.5 5 0.25 children [ Shape { appearance PBRAppearance { baseColor 0.12 0.58 0.22 roughness 0.8 } geometry Cylinder { height 0.5 radius 0.15 } } ] name "plant_r2_4" boundingObject Cylinder { height 0.5 radius 0.15 } }
